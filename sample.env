# Optional settings for geotz-api. Copy to .env in the directory you run it from.
# Precedence: command-line option, then environment variable, then .env, then default.

# Directory for the database and downloaded source files.
#DATA_PATH=data

# Where source files are downloaded from (e.g. a mirror).
#GEONAMES_BASE_DOWNLOAD_URL=https://download.geonames.org/export/dump/
#TIMEZONEDB_BASE_DOWNLOAD_URL=https://timezonedb.com/files/

# Finer control over locations; each defaults to a path under DATA_PATH.
#GEOTZ_DB=data/geotz.db
#GEOTZ_DATA_DIR=data/geonames
#GEOTZ_TZ_DIR=data/timezonedb

# Web service address.
#GEOTZ_HOST=127.0.0.1
#PORT=8089

# JSON keys in responses: snake_case by default; true or 1 gives camelCase.
#CAMEL_CASE=false
